;; Pre-M11 ABI callers consume one whole line per input import. Keep this module
;; independent of today's compiler so changed lowering cannot hide a regression.
(module
  (import "pas2wasm_v1" "read_i32" (func $integer (param i32 i32) (result i32)))
  (import "pas2wasm_v1" "read_f64" (func $real (param i32 i32) (result f64)))
  (import "pas2wasm_v1" "read_char" (func $char (param i32 i32) (result i32)))
  (import "pas2wasm_v1" "string_read" (func $string (param i32 i32 i32 i32)))
  (import "pas2wasm_v1" "discard_line" (func $discard (param i32 i32)))
  (import "pas2wasm_v1" "write_i32" (func $write_integer (param i32)))
  (import "pas2wasm_v1" "write_f64" (func $write_real (param f64)))
  (import "pas2wasm_v1" "write_char" (func $write_char (param i32 i32 i32)))
  (import "pas2wasm_v1" "string_write" (func $write_string (param i32 i32 i32)))
  (import "pas2wasm_v1" "newline" (func $newline))
  (memory (export "memory") 1 1024)
  (func (export "run")
    (call $write_integer (call $integer (i32.const 1) (i32.const 1)))
    (call $newline)
    (call $write_real (call $real (i32.const 2) (i32.const 1)))
    (call $newline)
    (call $write_char (call $char (i32.const 3) (i32.const 1)) (i32.const 3) (i32.const 1))
    (call $newline)
    (call $string (i32.const 0) (i32.const 16) (i32.const 4) (i32.const 1))
    (call $write_string (i32.const 0) (i32.const 4) (i32.const 1))
    (call $newline)
    (call $discard (i32.const 5) (i32.const 1))
    (call $write_integer (call $integer (i32.const 6) (i32.const 1)))
    (call $newline)))
